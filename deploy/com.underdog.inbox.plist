<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.underdog.inbox</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ronaktoprani/Documents/plytrademoch/venv/bin/python</string>
        <string>-m</string>
        <string>paper.run</string>
        <string>inbox</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/ronaktoprani/Documents/plytrademoch</string>
    <!-- 60s: this poll interval IS the reply latency for the bot's
         pnl/detail commands, and Telegram drops un-acknowledged updates after
         ~24h. NOTE: changing StartInterval needs bootout+bootstrap to take
         effect — `launchctl kickstart` does NOT re-read the plist. -->
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/ronaktoprani/Documents/plytrademoch/logs/inbox.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ronaktoprani/Documents/plytrademoch/logs/inbox.log</string>
</dict>
</plist>
