# ============================================================
# Polymarket Copy Trading Bot — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------
# Wallet / Authentication
# ----------------------------
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
CHAIN_ID=137

# ----------------------------
# API Hosts (defaults shown — only change if using a proxy/testnet)
# ----------------------------
POLYMARKET_HOST=https://polymarket.com
CLOB_HOST=https://clob.polymarket.com
GAMMA_HOST=https://gamma-api.polymarket.com
DATA_API_HOST=https://data-api.polymarket.com

# ----------------------------
# Copy Trading Parameters
# ----------------------------
POLL_INTERVAL_SECONDS=30
MIN_WHALE_PNL=100000
MIN_WIN_RATE=0.65
MIN_TRADES=50
MAX_TRACKED_WALLETS=10

# ----------------------------
# Position Sizing
# ----------------------------
BANKROLL=100.0
MIN_TRADE_SIZE=1.0
MAX_TRADE_SIZE=20.0

# ----------------------------
# Risk Limits
# ----------------------------
MAX_POSITION_PER_MARKET=20.0
MAX_PORTFOLIO_EXPOSURE=150.0
MAX_DAILY_LOSS=10.0

# ----------------------------
# Dashboard
# ----------------------------
DASHBOARD_PORT=8050
DASHBOARD_REFRESH_SECONDS=10

# ----------------------------
# Trading Mode
# ----------------------------
# Set to true for paper trading (no real orders placed)
DRY_RUN=true

# ----------------------------
# Telegram Notifications
# ----------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
